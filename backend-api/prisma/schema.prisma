generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Salon {
  id           String        @id @default(uuid())
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  users        User[]
  customers    Customer[]
  staff        Staff[]
  services     Service[]
  appointments Appointment[]
  payments     Payment[]
  inventory    Inventory[]
  products     Product[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("OWNER") // OWNER, MANAGER, STYLIST
  
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([salonId])
}

model Customer {
  id           String        @id @default(uuid())
  name         String
  email        String?
  phone        String?
  ltv          Float         @default(0) // Lifetime value
  risk         Int           @default(0) // Churn risk %
  lastVisit    DateTime?
  expectedVisit DateTime?
  
  salonId      String
  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  
  appointments Appointment[]
  payments     Payment[]
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([salonId])
  @@index([salonId, lastVisit])
}

model Staff {
  id           String        @id @default(uuid())
  name         String
  role         String
  rating       Float         @default(5.0)
  rebookRate   Int           @default(0) // %
  
  salonId      String
  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  
  appointments Appointment[]
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([salonId])
}

model Service {
  id           String        @id @default(uuid())
  name         String
  description  String?
  price        Float
  duration     Int           @default(60) // minutes
  
  salonId      String
  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  
  appointmentServices AppointmentService[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([salonId])
}

model Appointment {
  id           String   @id @default(uuid())
  date         DateTime
  status       String   @default("SCHEDULED") // SCHEDULED, COMPLETED, NO_SHOW, CANCELLED
  risk         Int      @default(0) // No-show risk %
  riskReason   String?
  
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  staffId      String
  staff        Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  salonId      String
  salon        Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  
  services     AppointmentService[]
  payments     Payment[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([salonId, date])
  @@index([salonId, status])
  @@index([customerId])
  @@index([staffId])
}

model AppointmentService {
  id            String   @id @default(uuid())
  
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  priceAtBooking Float      // To freeze the price at the time of booking

  createdAt     DateTime @default(now())

  @@index([appointmentId])
  @@index([serviceId])
}

model Payment {
  id            String   @id @default(uuid())
  amount        Float
  status        String   @default("COMPLETED") // COMPLETED, PENDING, REFUNDED
  paymentDate   DateTime @default(now())
  method        String   @default("CARD") // CARD, CASH, ONLINE
  
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  salonId       String
  salon         Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([salonId, paymentDate])
  @@index([salonId, status])
  @@index([appointmentId])
  @@index([customerId])
}

model Product {
  id           String      @id @default(uuid())
  name         String
  price        Float
  category     String?
  
  salonId      String
  salon        Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  
  inventory    Inventory?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([salonId])
}

model Inventory {
  id           String   @id @default(uuid())
  stock        Int      @default(0)
  supplier     String?
  daysLeft     Int      @default(0) // AI/Logic calculated days remaining
  reorderAlert String?
  
  productId    String   @unique
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  salonId      String
  salon        Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([salonId])
}
